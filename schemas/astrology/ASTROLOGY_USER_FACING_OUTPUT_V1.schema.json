{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ASTROLOGY_USER_FACING_OUTPUT_V1.schema.json",
  "title": "Astrology Production v1 User-Facing Output",
  "description": "Closed-world public artifact emitted by tools/astrology_output_guard.py after an admitted interpretation handoff and caller-authored draft pass provenance and Pre-Send validation. This schema describes transport shape only and grants no semantic interpretation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "status",
    "output_allowed",
    "adapter",
    "owners",
    "question",
    "conclusion",
    "evidence",
    "required_disclosures",
    "unsupported_factors",
    "conflicts",
    "used_fact_refs",
    "used_claim_refs",
    "source_provenance",
    "pre_send_attestations",
    "rendered_text"
  ],
  "properties": {
    "schema_name": {"const": "astrology_user_facing_output"},
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "ready_for_user"},
    "output_allowed": {"const": true},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "adapter_version",
        "authority",
        "semantic_interpretation_authored",
        "final_text_authored"
      ],
      "properties": {
        "adapter_id": {"const": "astrology-output-guard-v1"},
        "adapter_version": {"const": "1.0.0"},
        "authority": {"const": "provenance_and_pre_send_validation_only"},
        "semantic_interpretation_authored": {"const": false},
        "final_text_authored": {"const": false}
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_owner", "output_owner", "draft_schema"],
      "properties": {
        "method_owner": {"const": "ASTROLOGY.md"},
        "output_owner": {"const": "CHATGPT_OUTPUT.md"},
        "draft_schema": {"const": "ASTROLOGY_OUTPUT_DRAFT_V1.schema.json"}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "text", "focus", "exclusions"],
      "properties": {
        "question_id": {"type": "string", "minLength": 1},
        "text": {"type": ["string", "null"]},
        "focus": {
          "type": "array",
          "items": {"type": "string"}
        },
        "exclusions": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "conclusion": {"$ref": "#/$defs/output_unit"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/output_unit"}
    },
    "required_disclosures": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "unsupported_factors": {
      "type": "array",
      "items": {"type": "object"}
    },
    "conflicts": {
      "type": "array",
      "items": {"type": "object"}
    },
    "used_fact_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fact_ref"}
    },
    "used_claim_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/claim_ref"}
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["registry_record_id", "claim_id", "sources", "cautions"],
        "properties": {
          "registry_record_id": {"type": "string", "minLength": 1},
          "claim_id": {"type": "string", "minLength": 1},
          "sources": {"type": "array", "items": {"type": "object"}},
          "cautions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "pre_send_attestations": {"$ref": "#/$defs/pre_send_attestations"},
    "rendered_text": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "fact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "fact_id"],
      "properties": {
        "bundle": {"enum": ["natal", "transit"]},
        "fact_id": {"type": "string", "minLength": 1}
      }
    },
    "claim_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_record_id", "claim_id"],
      "properties": {
        "registry_record_id": {"type": "string", "minLength": 1},
        "claim_id": {"type": "string", "minLength": 1}
      }
    },
    "output_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "fact_refs", "claim_refs"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 1600},
        "fact_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fact_ref"}
        },
        "claim_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/claim_ref"}
        }
      }
    },
    "pre_send_attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_answer_checked",
        "scope_and_exclusions_checked",
        "evidence_language_checked",
        "conclusion_consistency_checked",
        "unresolved_handling_checked",
        "eligible_layer_checked",
        "structured_fact_provenance_checked",
        "unsupported_factor_boundary_checked",
        "conflict_and_caution_checked"
      ],
      "properties": {
        "direct_answer_checked": {"const": true},
        "scope_and_exclusions_checked": {"const": true},
        "evidence_language_checked": {"const": true},
        "conclusion_consistency_checked": {"const": true},
        "unresolved_handling_checked": {"const": true},
        "eligible_layer_checked": {"const": true},
        "structured_fact_provenance_checked": {"const": true},
        "unsupported_factor_boundary_checked": {"const": true},
        "conflict_and_caution_checked": {"const": true}
      }
    }
  }
}
