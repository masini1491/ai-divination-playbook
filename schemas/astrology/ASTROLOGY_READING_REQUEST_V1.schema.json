{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ASTROLOGY_READING_REQUEST_V1.schema.json",
  "title": "Astrology Production v1 Reading Request",
  "description": "Closed-world request contract for tools/astrology_orchestrator.py. This schema normalizes admitted input only; it does not grant interpretation or Reading Record storage authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "reading_mode",
    "subject_ref",
    "birth"
  ],
  "properties": {
    "schema_name": {
      "const": "astrology_reading_request"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "reading_mode": {
      "enum": [
        "natal",
        "transit"
      ]
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "birth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "birth_time_certainty",
        "location"
      ],
      "properties": {
        "local_datetime": {
          "type": "string",
          "minLength": 1,
          "description": "Naive ISO-8601 local wall time. IANA timezone resolution is owned by the selected location branch."
        },
        "birth_time_certainty": {
          "enum": [
            "exact",
            "approximate",
            "unknown"
          ]
        },
        "house_system": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Whole Sign",
            "Placidus",
            null
          ]
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "place": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "country_code": {
                  "type": "string",
                  "pattern": "^[A-Za-z]{2}$"
                }
              }
            },
            "coordinates": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "latitude",
                "longitude",
                "timezone_name"
              ],
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "timezone_name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "country": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "country_code": {
                  "type": "string",
                  "pattern": "^[A-Za-z]{2}$"
                }
              },
              "anyOf": [
                {
                  "required": [
                    "name"
                  ]
                },
                {
                  "required": [
                    "country_code"
                  ]
                }
              ]
            }
          },
          "oneOf": [
            {
              "required": [
                "place"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "coordinates"
                    ]
                  },
                  {
                    "required": [
                      "country"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "coordinates"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "place"
                    ]
                  },
                  {
                    "required": [
                      "country"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "country"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "place"
                    ]
                  },
                  {
                    "required": [
                      "coordinates"
                    ]
                  }
                ]
              }
            }
          ]
        },
        "local_date": {
          "type": "string",
          "minLength": 1,
          "description": "ISO-8601 local calendar date YYYY-MM-DD, admitted only when birth_time_certainty=unknown."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "birth_time_certainty": {
                "const": "unknown"
              }
            },
            "required": [
              "birth_time_certainty"
            ]
          },
          "then": {
            "required": [
              "local_date"
            ],
            "properties": {
              "house_system": {
                "const": null
              }
            },
            "not": {
              "required": [
                "local_datetime"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "birth_time_certainty": {
                "enum": [
                  "exact",
                  "approximate"
                ]
              }
            },
            "required": [
              "birth_time_certainty"
            ]
          },
          "then": {
            "required": [
              "local_datetime",
              "house_system"
            ],
            "not": {
              "required": [
                "local_date"
              ]
            }
          }
        }
      ]
    },
    "transit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_utc",
        "end_utc",
        "moving_bodies"
      ],
      "properties": {
        "start_utc": {
          "type": "string",
          "minLength": 1
        },
        "end_utc": {
          "type": "string",
          "minLength": 1
        },
        "moving_bodies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Sun",
              "Moon",
              "Mercury",
              "Venus",
              "Mars",
              "Jupiter",
              "Saturn",
              "Uranus",
              "Neptune",
              "Pluto"
            ]
          }
        },
        "natal_targets": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Sun",
              "Moon",
              "Mercury",
              "Venus",
              "Mars",
              "Jupiter",
              "Saturn",
              "Uranus",
              "Neptune",
              "Pluto",
              "NorthNode"
            ]
          }
        },
        "aspects": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "enum": [
              "conjunction",
              "opposition",
              "trine",
              "square",
              "sextile"
            ]
          }
        },
        "include_stations": {
          "type": "boolean",
          "default": true
        },
        "include_ingresses": {
          "type": "boolean",
          "default": true
        },
        "include_transit_to_natal": {
          "type": "boolean",
          "default": true
        },
        "include_house_ingresses": {
          "type": "boolean",
          "default": false
        },
        "include_house_context": {
          "type": "boolean",
          "default": false
        },
        "house_context_utc": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "include_transit_to_natal": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "natal_targets",
              "aspects"
            ],
            "properties": {
              "natal_targets": {
                "minItems": 1
              },
              "aspects": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "include_house_context": {
                "const": true
              }
            },
            "required": [
              "include_house_context"
            ]
          },
          "then": {
            "required": [
              "house_context_utc"
            ]
          }
        }
      ]
    },
    "extended_objects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Explicit known-time natal request for production-admitted extended ephemeris calculation facts only. Does not grant semantic interpretation or default aspect participation.",
      "items": {
        "enum": [
          "Chiron",
          "Ceres",
          "Pallas",
          "Juno",
          "Vesta"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reading_mode": {
            "const": "transit"
          }
        },
        "required": [
          "reading_mode"
        ]
      },
      "then": {
        "required": [
          "transit"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "reading_mode": {
            "const": "natal"
          }
        },
        "required": [
          "reading_mode"
        ]
      },
      "then": {
        "not": {
          "required": [
            "transit"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "birth": {
            "properties": {
              "birth_time_certainty": {
                "const": "unknown"
              }
            },
            "required": [
              "birth_time_certainty"
            ]
          }
        },
        "required": [
          "birth"
        ]
      },
      "then": {
        "properties": {
          "reading_mode": {
            "const": "natal"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "birth": {
            "properties": {
              "location": {
                "required": [
                  "country"
                ]
              }
            },
            "required": [
              "location"
            ]
          }
        },
        "required": [
          "birth"
        ]
      },
      "then": {
        "properties": {
          "reading_mode": {
            "const": "natal"
          },
          "birth": {
            "properties": {
              "birth_time_certainty": {
                "const": "unknown"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "extended_objects"
        ]
      },
      "then": {
        "properties": {
          "reading_mode": {
            "const": "natal"
          },
          "birth": {
            "properties": {
              "birth_time_certainty": {
                "enum": [
                  "exact",
                  "approximate"
                ]
              }
            },
            "required": [
              "birth_time_certainty"
            ]
          }
        }
      }
    }
  ]
}
