{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ZIWEI_READING_REQUEST_V1.schema.json",
  "title": "Zi Wei Production v1 Reading Request",
  "description": "Closed-world request contract for tools/ziwei_runtime.py. It composes only already-admitted Zi Wei Scope-A capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "request_id",
    "temporal_scope",
    "birth",
    "optional_modules",
    "requested_subjects",
    "enabled_source_ids"
  ],
  "properties": {
    "schema_name": {
      "const": "ziwei_reading_request"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "temporal_scope": {
      "const": "natal_baseline"
    },
    "birth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_type",
            "year",
            "month",
            "day",
            "hour",
            "minute",
            "second",
            "timezone"
          ],
          "properties": {
            "input_type": {
              "const": "gregorian"
            },
            "year": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2100
            },
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            },
            "hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "minute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 59
            },
            "second": {
              "type": "integer",
              "minimum": 0,
              "maximum": 59
            },
            "timezone": {
              "const": "Asia/Taipei"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_type",
            "lunar_year",
            "lunar_month",
            "lunar_day",
            "hour_branch",
            "calendar_provenance",
            "leap_month_identity"
          ],
          "properties": {
            "input_type": {
              "const": "normalized_lunar"
            },
            "lunar_year": {
              "type": "integer"
            },
            "lunar_month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "lunar_day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "hour_branch": {
              "enum": [
                "子",
                "丑",
                "寅",
                "卯",
                "辰",
                "巳",
                "午",
                "未",
                "申",
                "酉",
                "戌",
                "亥"
              ]
            },
            "calendar_provenance": {
              "type": "string",
              "minLength": 1
            },
            "leap_month_identity": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "optional_modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "brightness_v1",
          "m0_auxiliary_v1"
        ]
      }
    },
    "requested_subjects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "enabled_source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "brightness_profile": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ziwei.brightness.iztro_v1",
        null
      ],
      "default": null
    },
    "m0_auxiliary_profile": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ziwei.auxiliary.m0.iztro_v1",
        null
      ],
      "default": null
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "brightness_profile": {
            "const": "ziwei.brightness.iztro_v1"
          }
        },
        "required": [
          "brightness_profile"
        ]
      },
      "then": {
        "properties": {
          "optional_modules": {
            "contains": {
              "const": "brightness_v1"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "m0_auxiliary_profile": {
            "const": "ziwei.auxiliary.m0.iztro_v1"
          }
        },
        "required": [
          "m0_auxiliary_profile"
        ]
      },
      "then": {
        "properties": {
          "optional_modules": {
            "contains": {
              "const": "m0_auxiliary_v1"
            }
          }
        }
      }
    }
  ]
}
