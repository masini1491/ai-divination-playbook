{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ASTROLOGY_READING_REQUEST_V1.schema.json",
  "title": "Astrology Production v1 Reading Request",
  "description": "Closed-world request contract for tools/astrology_orchestrator.py. This schema normalizes admitted input only; it does not grant interpretation or Reading Record storage authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "reading_mode",
    "subject_ref",
    "birth"
  ],
  "properties": {
    "schema_name": {
      "const": "astrology_reading_request"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "reading_mode": {
      "enum": [
        "natal",
        "transit"
      ]
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "birth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_datetime",
        "birth_time_certainty",
        "house_system",
        "location"
      ],
      "properties": {
        "local_datetime": {
          "type": "string",
          "minLength": 1,
          "description": "Naive ISO-8601 local wall time. IANA timezone resolution is owned by the selected location branch."
        },
        "birth_time_certainty": {
          "enum": [
            "exact",
            "approximate"
          ]
        },
        "house_system": {
          "enum": [
            "Whole Sign",
            "Placidus"
          ]
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "place": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "country_code": {
                  "type": "string",
                  "pattern": "^[A-Za-z]{2}$"
                }
              }
            },
            "coordinates": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "latitude",
                "longitude",
                "timezone_name"
              ],
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "timezone_name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "oneOf": [
            {
              "required": [
                "place"
              ],
              "not": {
                "required": [
                  "coordinates"
                ]
              }
            },
            {
              "required": [
                "coordinates"
              ],
              "not": {
                "required": [
                  "place"
                ]
              }
            }
          ]
        }
      }
    },
    "transit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_utc",
        "end_utc",
        "moving_bodies",
        "natal_targets",
        "aspects"
      ],
      "properties": {
        "start_utc": {
          "type": "string",
          "minLength": 1
        },
        "end_utc": {
          "type": "string",
          "minLength": 1
        },
        "moving_bodies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Sun",
              "Moon",
              "Mercury",
              "Venus",
              "Mars",
              "Jupiter",
              "Saturn",
              "Uranus",
              "Neptune",
              "Pluto"
            ]
          }
        },
        "natal_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Sun",
              "Moon",
              "Mercury",
              "Venus",
              "Mars",
              "Jupiter",
              "Saturn",
              "Uranus",
              "Neptune",
              "Pluto",
              "NorthNode"
            ]
          }
        },
        "aspects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "conjunction",
              "opposition",
              "trine",
              "square",
              "sextile"
            ]
          }
        },
        "include_stations": {
          "type": "boolean",
          "default": true
        },
        "include_ingresses": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reading_mode": {
            "const": "transit"
          }
        },
        "required": [
          "reading_mode"
        ]
      },
      "then": {
        "required": [
          "transit"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "reading_mode": {
            "const": "natal"
          }
        },
        "required": [
          "reading_mode"
        ]
      },
      "then": {
        "not": {
          "required": [
            "transit"
          ]
        }
      }
    }
  ]
}
