{
  "schema_name": "astrology_place_resolver_admission",
  "schema_version": "1.0.0",
  "resolver_id": "geonamescache-city-v1",
  "resolver_version": "1.1.0",
  "status": "PRODUCTION_ADMITTED",
  "scope": [
    "city_or_locality_name_to_coordinates_and_iana_timezone",
    "country_name_or_code_to_unique_iana_timezone"
  ],
  "runtime_owner": "tools/astrology_place_resolver.py",
  "dependency": {
