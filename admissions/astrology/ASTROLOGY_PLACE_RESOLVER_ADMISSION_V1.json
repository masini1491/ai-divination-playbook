      "input_shape": "recognized Taiwan county/city prefix + exact township/district token",
      "script_variant": "台→臺 only inside bounded Taiwan administrative matching",
      "hierarchy_validation": "exact repo-owned county/city × township/district allowlist",
      "effective_country_code": "TW",
      "downstream_resolution": "existing exact name/alternate-name match; contains_search remains false",
      "unsupported_or_mismatched_pair": "fail_closed",
      "coordinates_authority": false
    }
  },
  "output": [
    "geoname_id",
    "name",
    "country_code",
    "admin1_code",
    "latitude",
    "longitude",
    "timezone_name",
    "population",
    "country-only: name, country_code, timezone_name"
