{
  "schema_name": "astrology_transit_provider_admission",
  "schema_version": "1.0.0",
  "provider_id": "astronomy-engine-transit-v1",
  "provider_version": "1.0.0",
  "status": "PRODUCTION_ADMITTED",
  "scope": ["transit_to_natal_exact_aspects", "stations", "tropical_ingresses"],
  "runtime_owner": "tools/astrology_transit_provider.py",
  "output_schema": "astrology_fact_bundle@1.0.0",
  "dependency": {
    "package": "astronomy-engine",
    "version": "2.1.19",
    "source_repository": "cosinekitty/astronomy",
    "source_revision": "865d3da7d8112bbc7911238052c6af4aaf877181",
    "license": "MIT"
  },
  "input_contract": {
    "natal_bundle": "admitted natal Astrology Fact Bundle 1.0",
    "search_time_basis": "UTC",
    "max_search_days": 400,
    "moving_bodies": ["Sun", "Moon", "Mercury", "Venus", "Mars", "Jupiter", "Saturn", "Uranus", "Neptune", "Pluto"],
    "natal_targets": "supported natal planet/point longitudes present in admitted natal bundle",
    "major_aspects": ["conjunction", "opposition", "trine", "square", "sextile"]
  },
  "calculation_policy": {
    "zodiac_system": "tropical",
    "center": "geocentric",
    "canonical_event_time": "UTC",
    "root_tolerance_seconds": 0.5,
    "default_scan_step_hours": 3.0,
    "station_scan_step_hours": 6.0,
    "retrograde_multiple_passages": "preserve_all_exact_roots_with_sequence",
    "ingress_boundaries": "30_degree_tropical_sign_boundaries",
    "local_time_rendering": "derived_only_from_UTC_and_explicit_IANA_timezone",
    "interpretation_authority": "none"
  },
  "validation": {
    "production_tests": "tests/test_astrology_transit_provider.py",
    "cross_engine_reference": [
      "references/astrology/TRANSIT_NATAL_INGRESS_TIMEZONE_RESULTS.md",
      "references/astrology/TRANSIT_TIMING_VALIDATION_RESULTS.md"
    ],
    "mercury_three_pass_topology": "required",
    "mercury_three_pass_time_tolerance_seconds": 600,
    "mercury_station_2026_count": 6,
    "saturn_station_2026_count": 2,
    "venus_210_boundary_2026_crossing_count": 3,
    "runtime_gate_required": true
  },
  "not_admitted": [
    "transit_house search",
    "angle/cusp transit timing beyond supplied natal target facts",
    "sidereal ingress",
    "eclipse prediction",
    "lunation prediction as an event-outcome guarantee",
    "unbounded search windows",
    "topocentric transit geometry",
    "event interpretation inside provider"
  ],
  "scientific_predictive_validity_claimed": false
}
