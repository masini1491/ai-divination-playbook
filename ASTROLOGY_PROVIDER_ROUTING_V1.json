{
  "schema_name": "astrology_provider_routing",
  "schema_version": "1.0.0",
  "status": "PRODUCTION_ROUTING_POLICY",
  "selector_owner": "tools/astrology_provider_selector.py",
  "fact_bundle_schema": "astrology_fact_bundle@1.0.0",
  "providers": {
    "astronomy-engine-natal-v1": {
      "role": [
        "portable_default",
        "fallback"
      ],
      "admission_manifest": "ASTROLOGY_PROVIDER_ADMISSION_V1.json",
      "status": "PRODUCTION_ADMITTED"
    },
    "swiss-host-natal-v1": {
      "role": [
        "chatgpt_preferred_candidate"
      ],
      "admission_manifest": "ASTROLOGY_SWISS_PROVIDER_ADMISSION_V1.json",
      "status": "LICENSE_AND_ADMISSION_GATED"
    }
  },
  "routes": {
    "chatgpt": {
      "known_time_natal": {
        "preferred_provider_id": "swiss-host-natal-v1",
        "fallback_provider_id": "astronomy-engine-natal-v1",
        "preference_requires": [
          "provider_admission=PRODUCTION_ADMITTED",
          "license_status=RESOLVED",
          "host_runtime_probe=PASS",
          "request_scope_admitted=true"
        ]
      },
      "unknown_time_natal": {
        "provider_id": "astronomy-engine-natal-v1"
      },
      "transit": {
        "provider_id": "astronomy-engine-natal-v1"
      }
    },
    "portable": {
      "known_time_natal": {
        "provider_id": "astronomy-engine-natal-v1"
      },
      "unknown_time_natal": {
        "provider_id": "astronomy-engine-natal-v1"
      },
      "transit": {
        "provider_id": "astronomy-engine-natal-v1"
      }
    }
  },
  "fallback_semantics": {
    "fallback_is_not_error": true,
    "preserve_fact_bundle_schema": true,
    "preserve_runtime_gate": true,
    "swiss_probe_failure_does_not_block_astrology": true,
    "swiss_license_or_admission_gap_does_not_block_astronomy_fallback": true
  },
  "host_identity": {
    "chatgpt_must_be_asserted_by_execution_surface": true,
    "subscription_plan_is_not_capability_evidence": true,
    "runtime_capability_must_be_probed": true
  }
}
